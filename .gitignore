# ==============================================================================
# PATTIES / ORDERLY — PRODUCTION .GITIGNORE
# ==============================================================================

# 1. Dependências do Node.js
node_modules/
*/node_modules/
package-lock.json.bak

# 2. Variáveis de Ambiente & Segredos (CRÍTICO)
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
backend/.env
frontend/.env
frontend/.env.local

# 3. Bancos de Dados Locais & Arquivos SQLite
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
backend/database/
backend/dev.sqlite

# 4. Saídas de Build & Compilação
dist/
dist-ssr/
build/
frontend/dist/
*.tsbuildinfo

# 5. Logs & Debuggers
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Testes & Relatórios de Cobertura
coverage/
.nyc_output/

# 7. Arquivos do Sistema Operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 8. Arquivos de Editores & IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project

# 9. Arquivos temporários pesados soltos na raiz (vídeos brutos/renderizações)
/*.mp4
/*.mov
/*.avi
/*.mkv
# Mantém o vídeo oficial da hero em frontend/public/videos/
!frontend/public/videos/hero.mp4

# 10. Arquivos de pacotes comprimidos
*.jar
*.war
*.zip
*.tar.gz
*.rar
